# SEC EDGAR identity. Required by SEC fair-access policy.
# Format: "Your Name your.email@example.com"
EDGAR_IDENTITY="Your Name your.email@example.com"

# Alpaca credentials. Leave blank to run in read-only / preview mode.
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_PAPER=true

# Default scaling parameters.
TARGET_PORTFOLIO_SIZE=10000
DEFAULT_CIK=0002045724

# Safety gates. All of the following default to false. Auto live execution
# requires ALL THREE of ALPACA_PAPER=false, ALLOW_LIVE_TRADING=true,
# ALLOW_LIVE_AUTO_EXECUTE=true, AND AUTO_EXECUTE=true.
AUTO_EXECUTE=false
ALLOW_LIVE_TRADING=false
ALLOW_LIVE_AUTO_EXECUTE=false

# Trade sizing.
MIN_TRADE_NOTIONAL=10

# Background rebalancer interval (hours).
REBALANCE_INTERVAL_HOURS=1

# Optional SMTP notifications.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM=""
EMAIL_TO=""

# Optional Slack notifications.
SLACK_WEBHOOK_URL=""
